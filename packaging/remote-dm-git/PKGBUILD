# remote-dm: display manager for remote logins with gnome-remote-desktop (see remote-dm/README.md).
#
# Builds remote-dm/ from the remote-desktop branch of the git repository this PKGBUILD lives in
# (committed changes only). Override with NIRI_REPO=<url or path> and NIRI_BRANCH=<branch>.

pkgname=remote-dm-git
pkgver=r0.0
pkgrel=1
pkgdesc="Display manager for remote logins with gnome-remote-desktop"
arch=(x86_64)
url="https://github.com/YaLTeR/niri"
license=(GPL-3.0-only)
depends=(
  dbus
  gcc-libs
  glibc
  gnome-remote-desktop
  niri
  pam
  systemd
)
makedepends=(
  git
  rust
)
optdepends=(
  'greetd-regreet: greeter (the default greeter.kdl)'
  'noctalia-greeter: greeter (greeter-noctalia.kdl)'
)
provides=(remote-dm)
conflicts=(remote-dm)
backup=(
  etc/pam.d/remote-dm
  etc/pam.d/remote-dm-autologin
  etc/pam.d/remote-dm-greeter
  etc/remote-dm/config.toml
  etc/remote-dm/greeter.kdl
  etc/remote-dm/greeter-noctalia.kdl
)
_repo=${NIRI_REPO:-$(realpath "$startdir/../..")}
source=("niri::git+file://${_repo#file://}#branch=${NIRI_BRANCH:-remote-desktop}")
case $_repo in *://*) source=("niri::git+$_repo#branch=${NIRI_BRANCH:-remote-desktop}") ;; esac
sha256sums=('SKIP')

pkgver() {
  cd niri
  printf 'r%s.%s' "$(git rev-list --count HEAD -- remote-dm)" "$(git log -1 --format=%h -- remote-dm)"
}

prepare() {
  cd niri/remote-dm
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd niri/remote-dm
  cargo build --frozen --release
}

package() {
  cd niri/remote-dm
  DESTDIR="$pkgdir" ./install.sh --no-build > /dev/null
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/remote-dm/"
}
