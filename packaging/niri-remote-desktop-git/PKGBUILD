# Maintainer: c0de-coffee <53132135+c0de-coffee@users.noreply.github.com>
#
# niri with remote desktop support (org.gnome.Mutter.RemoteDesktop, virtual outputs), for remote
# logins with gnome-remote-desktop and remote-dm. Based on Arch's niri PKGBUILD.
#
# Builds the remote-desktop branch: of the repository this PKGBUILD lives in (committed changes
# only), or of https://github.com/c0de-coffee/niri when built elsewhere (AUR). Override with
# NIRI_REPO=<url or path> and NIRI_BRANCH=<branch>.

pkgname=niri-remote-desktop-git
pkgver=26.4.0.r0.g00000000
pkgrel=1
pkgdesc="A scrollable-tiling Wayland compositor (with remote desktop support)"
arch=(x86_64)
url="https://github.com/c0de-coffee/niri"
license=(GPL-3.0-or-later)
depends=(
  cairo
  glib2
  glibc
  libdisplay-info
  libgcc
  libinput
  libpipewire
  libxkbcommon
  mesa
  pango
  pixman
  seatd
  systemd-libs
  xdg-desktop-portal-impl
)
makedepends=(
  clang
  git
  rust
)
optdepends=(
  'bash: for niri-session script'
  'xwayland-satellite: for running X11 apps in XWayland'
  'xdg-desktop-portal-gnome: a XDG desktop portal required for screencasting'
  'gnome-remote-desktop: remote desktop and remote login over RDP'
)
provides=(niri wayland-compositor)
conflicts=(niri niri-remote-desktop)
# Inside a checkout of the repository (packaging/<pkg>/): the local repo; elsewhere (AUR): GitHub.
_repo=${NIRI_REPO:-$( [ -d "$startdir/../../.git" ] && realpath "$startdir/../.." || echo https://github.com/c0de-coffee/niri)}
source=("niri::git+file://${_repo#file://}#branch=${NIRI_BRANCH:-remote-desktop}")
case $_repo in *://*) source=("niri::git+$_repo#branch=${NIRI_BRANCH:-remote-desktop}") ;; esac
sha256sums=('SKIP')

pkgver() {
  cd niri
  # Not from tags: forks and shallow clones often don't carry upstream's.
  printf '%s.r%s.g%s' "$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
  cd niri
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd niri
  export NIRI_BUILD_COMMIT="$(git rev-parse --short=7 HEAD)"
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release --features default

  for shell in bash fish zsh; do
    target/release/niri completions "$shell" > "$shell-completions"
  done
}

check() {
  cd niri
  export XDG_RUNTIME_DIR="$(mktemp -d)"
  export RAYON_NUM_THREADS=1
  cargo test --all --exclude niri-visual-tests --frozen
}

package() {
  cd niri
  install -vDm 755 target/release/niri resources/niri-session -t "$pkgdir/usr/bin/"
  install -vDm 644 resources/niri{.service,-shutdown.target} -t "$pkgdir/usr/lib/systemd/user/"
  install -vDm 644 resources/niri.desktop -t "$pkgdir/usr/share/wayland-sessions/"
  install -vDm 644 resources/niri-portals.conf -t "$pkgdir/usr/share/xdg-desktop-portal/"
  install -vDm 644 resources/default-config.kdl README.md -t "$pkgdir/usr/share/doc/niri/"
  install -vDm 644 bash-completions "$pkgdir/usr/share/bash-completion/completions/niri"
  install -vDm 644 fish-completions "$pkgdir/usr/share/fish/vendor_completions.d/niri.fish"
  install -vDm 644 zsh-completions "$pkgdir/usr/share/zsh/site-functions/_niri"
}
