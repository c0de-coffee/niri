// For manual testing over RDP:
// - a text editor (keyboard, pointer)
// - gears (continuous frames)
// - a terminal printing an increasing counter: if numbers ever jump backwards, old frames are
//   being shown (gears alone can't tell, they look like they jump back due to the wagon-wheel effect)
debug {
    dbus-interfaces-in-non-session-instances
}

spawn-at-startup "gnome-text-editor"
spawn-at-startup "eglgears_wayland"
spawn-at-startup "kgx" "--" "sh" "-c" "i=0; while :; do i=$((i+1)); printf '\\r%08d' $i; sleep 0.01; done"
